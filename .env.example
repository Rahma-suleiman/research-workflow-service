# Local development example only. Never use these example values in production.
WORKFLOW_DB_URL=jdbc:postgresql://localhost:5432/research_workflow_db
WORKFLOW_DB_USERNAME=workflow_service_user
WORKFLOW_DB_PASSWORD=replace-for-local-development
WORKFLOW_ADMIN_USERNAME=workflow_admin
WORKFLOW_ADMIN_PASSWORD=replace-with-a-strong-local-password
WORKFLOW_SERVICE_USERNAME=permit_workflow_api
WORKFLOW_SERVICE_PASSWORD=replace-with-a-strong-local-password
WORKFLOW_ACTOR_SIGNING_SECRET=replace-with-a-random-secret-of-at-least-32-characters
WORKFLOW_DB_POOL_MAX_SIZE=10
WORKFLOW_DB_POOL_MIN_IDLE=2
WORKFLOW_DB_CONNECTION_TIMEOUT_MS=30000
WORKFLOW_DB_VALIDATION_TIMEOUT_MS=5000
# Production defaults to false; enable only for protected internal access.
WORKFLOW_API_DOCS_ENABLED=false
